[sub_resource type="GDScript" id="GDScript_5hmxv"]
resource_name = "Elevator"
script/source = "class_name ElevatorEntrance
extends AnimatableBody2D

## Elevator entrance that plays when arriving in a new level.
## Starts with black screen, player on elevator unable to move,
## then elevator ascends while screen fades in, then enables movement.

signal entrance_started
signal elevator_finished
signal entrance_completed

@export_group(\"Elevator Movement\")
@export var move_distance: float = 370.0  ## How far UP the elevator moves
@export var move_duration: float = 3.0
@export var move_ease: Tween.EaseType = Tween.EASE_IN_OUT
@export var move_trans: Tween.TransitionType = Tween.TRANS_SINE
@export var start_delay: float = 0.3  ## Brief delay before elevator starts

@export_group(\"Screen Fade\")
@export var fade_color: Color = Color.BLACK
@export var fade_delay: float = 0.3  ## Delay after movement starts before fade begins
@export var fade_duration: float = 1.5
@export var movement_enable_delay: float = 0.2  ## Delay after fade before enabling movement

@export_group(\"Player\")
@export var player_offset: Vector2 = Vector2(0, -20)  ## Player position relative to elevator center

@export_group(\"Audio\")
@export var elevator_sound: AudioStream
@export var arrival_sound: AudioStream

var _player: CharacterBody2D = null
var _activated: bool = false
var _completed: bool = false
var _fade_overlay: ColorRect
var _audio_player: AudioStreamPlayer


func _ready() -> void:
	_setup_fade_overlay()
	_setup_audio()
	
	# Start entrance sequence on next frame to ensure scene is ready
	call_deferred(\"_begin_entrance_sequence\")


func _setup_fade_overlay() -> void:
	var canvas := CanvasLayer.new()
	canvas.name = \"FadeCanvas\"
	canvas.layer = 100
	add_child(canvas)
	
	_fade_overlay = ColorRect.new()
	_fade_overlay.name = \"FadeOverlay\"
	_fade_overlay.color = fade_color  # Start fully opaque
	_fade_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_fade_overlay.set_anchors_preset(Control.PRESET_FULL_RECT)
	
	canvas.add_child(_fade_overlay)


func _setup_audio() -> void:
	_audio_player = AudioStreamPlayer.new()
	_audio_player.name = \"ElevatorAudio\"
	add_child(_audio_player)


func _begin_entrance_sequence() -> void:
	if _activated:
		return
	
	_activated = true
	
	# Find and attach player
	_find_and_attach_player()
	
	if not _player:
		push_warning(\"ElevatorEntrance: No player found!\")
		_fade_overlay.color.a = 0.0
		return
	
	entrance_started.emit()
	
	# Disable player movement
	_disable_player_movement()
	
	# Brief delay before starting
	await get_tree().create_timer(start_delay).timeout
	
	# Start elevator sequence
	_start_elevator_ascent()


func _find_and_attach_player() -> void:
	# Find player in scene
	_player = get_tree().get_first_node_in_group(\"player\") as CharacterBody2D
	
	if not _player:
		return
	
	# Reparent player to elevator
	var original_parent := _player.get_parent()
	if original_parent:
		original_parent.remove_child(_player)
	
	add_child(_player)
	
	# Position player on elevator using local position (so they move with elevator)
	_player.position = player_offset
	_player.velocity = Vector2.ZERO


func _start_elevator_ascent() -> void:
	# Play elevator sound
	if elevator_sound:
		_audio_player.stream = elevator_sound
		_audio_player.play()
	
	# Move elevator UP (Y decreases = up in Godot 2D)
	var end_position_y := position.y - move_distance
	
	var move_tween := create_tween()
	move_tween.tween_property(self, \"position:y\", end_position_y, move_duration) \\
		.set_ease(move_ease).set_trans(move_trans)
	
	move_tween.finished.connect(_on_elevator_finished)
	
	# Start fade after delay
	await get_tree().create_timer(fade_delay).timeout
	_start_fade_in()


func _start_fade_in() -> void:
	var fade_tween := create_tween()
	fade_tween.tween_property(_fade_overlay, \"color:a\", 0.0, fade_duration) \\
		.set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)


func _on_elevator_finished() -> void:
	elevator_finished.emit()
	
	# Play arrival sound
	if arrival_sound:
		_audio_player.stream = arrival_sound
		_audio_player.play()
	
	# Wait for fade to complete plus extra delay
	await get_tree().create_timer(movement_enable_delay).timeout
	
	_complete_entrance()


func _complete_entrance() -> void:
	if _completed:
		return
	
	_completed = true
	
	# Detach player from elevator and return to level
	_detach_player_from_elevator()
	
	# Enable player movement
	_enable_player_movement()
	
	entrance_completed.emit()


func _detach_player_from_elevator() -> void:
	if not _player or not is_instance_valid(_player):
		return
	
	var player_global_pos := _player.global_position
	
	# Remove from elevator
	remove_child(_player)
	
	# Add back to level root
	var level := get_tree().current_scene
	if level:
		level.add_child(_player)
		_player.global_position = player_global_pos


func _disable_player_movement() -> void:
	if not _player:
		return
	
	# Stop all velocity
	_player.velocity = Vector2.ZERO
	
	# Disable physics processing to prevent any movement
	_player.set_physics_process(false)
	
	# Also try built-in methods
	if _player.has_method(\"set_input_enabled\"):
		_player.set_input_enabled(false)
	elif \"is_spawning\" in _player:
		_player.is_spawning = true
	elif \"movement\" in _player and _player.movement:
		if _player.movement.has_method(\"set_enabled\"):
			_player.movement.set_enabled(false)


func _enable_player_movement() -> void:
	if not _player or not is_instance_valid(_player):
		return
	
	# Re-enable physics processing
	_player.set_physics_process(true)
	
	# Reset velocity
	_player.velocity = Vector2.ZERO
	
	if _player.has_method(\"set_input_enabled\"):
		_player.set_input_enabled(true)
	elif \"is_spawning\" in _player:
		_player.is_spawning = false
	elif \"movement\" in _player and _player.movement:
		if _player.movement.has_method(\"set_enabled\"):
			_player.movement.set_enabled(true)


# --- Public API ---

## Check if entrance sequence has completed
func is_completed() -> bool:
	return _completed


## Skip the entrance animation (for debugging or cutscene skips)
func skip() -> void:
	if _completed:
		return
	
	# Instantly complete everything
	position.y -= move_distance
	_fade_overlay.color.a = 0.0
	_complete_entrance()
"

