[sub_resource type="GDScript" id="GDScript_i1qk0"]
resource_name = "Librarian "
script/source = "class_name DialogueComponent
extends Node

signal dialogue_started
signal dialogue_line_shown(line_index: int)

@export_group(\"Dialogue Content\")
@export_multiline var dialogue_lines: Array[String] = []
@export var speaker_name: String = \"\"
@export var can_repeat: bool = true

@export_group(\"Interaction\")
@export var interaction_range: float = 150.0
@export var interaction_action: String = \"movement_jump\"
@export var advance_action: String = \"movement_jump\"
@export var show_prompt: bool = true
@export var prompt_text: String = \"Press [Jump] to talk\"

@export_group(\"Text Display\")
@export var characters_per_second: float = 30.0

@export_group(\"Appearance\")
@export var box_offset: Vector2 = Vector2(0, -60)
@export var padding: Vector2 = Vector2(12, 8)
@export var background_color: Color = Color(0.1, 0.1, 0.15, 0.95)
@export var border_color: Color = Color(0.4, 0.4, 0.5, 1.0)
@export var border_width: float = 2.0
@export var corner_radius: float = 6.0
@export var text_color: Color = Color.WHITE
@export var name_color: Color = Color(0.6, 0.8, 1.0)
@export var font_size: int = 14
@export var name_font_size: int = 12

@export_group(\"Auto Size Limits\")
@export var min_box_width: float = 120.0
@export var min_box_height: float = 60.0
@export var max_box_width: float = 320.0
@export var max_box_height: float = 180.0

@export_group(\"Animation\")
@export var popup_duration: float = 0.15


# -------------------------------------------------------------------
# Internal state
# -------------------------------------------------------------------
var _parent: Node2D
var _dialogue_active: bool = false
var _current_line: int = 0
var _displayed_characters: int = 0
var _current_text: String = \"\"
var _text_timer: float = 0.0
var _text_complete: bool = false
var _waiting_for_input: bool = false
var _has_shown_dialogue: bool = false

# UI
var _dialogue_box: Control
var _panel: Panel
var _name_label: Label
var _text_label: RichTextLabel
var _continue_indicator: Label
var _prompt_label: Label
var _detection_area: Area2D


func _ready() -> void:
	_parent = get_parent() as Node2D
	_setup_detection_area()
	_setup_dialogue_ui()
	_setup_prompt()


# -------------------------------------------------------------------
# Detection
# -------------------------------------------------------------------
func _setup_detection_area() -> void:
	_detection_area = Area2D.new()

	if _parent:
		_parent.add_child(_detection_area)
	else:
		add_child(_detection_area)

	var collision := CollisionShape2D.new()
	var shape := CircleShape2D.new()
	shape.radius = interaction_range
	collision.shape = shape
	_detection_area.add_child(collision)

	_detection_area.collision_layer = 0
	_detection_area.collision_mask = 1
	_detection_area.body_entered.connect(_on_body_entered)


# -------------------------------------------------------------------
# UI setup
# -------------------------------------------------------------------
func _setup_dialogue_ui() -> void:
	_dialogue_box = Control.new()
	_dialogue_box.visible = false
	_dialogue_box.scale = Vector2.ZERO
	_dialogue_box.z_index = 100

	if _parent:
		_parent.add_child.call_deferred(_dialogue_box)
	else:
		add_child(_dialogue_box)

	_panel = Panel.new()
	_dialogue_box.add_child(_panel)

	var style := StyleBoxFlat.new()
	style.bg_color = background_color
	style.border_color = border_color
	style.border_width_left = int(border_width)
	style.border_width_right = int(border_width)
	style.border_width_top = int(border_width)
	style.border_width_bottom = int(border_width)
	style.corner_radius_top_left = int(corner_radius)
	style.corner_radius_top_right = int(corner_radius)
	style.corner_radius_bottom_left = int(corner_radius)
	style.corner_radius_bottom_right = int(corner_radius)
	_panel.add_theme_stylebox_override(\"panel\", style)

	_name_label = Label.new()
	_name_label.text = speaker_name
	_name_label.visible = not speaker_name.is_empty()
	_name_label.add_theme_font_size_override(\"font_size\", name_font_size)
	_name_label.add_theme_color_override(\"font_color\", name_color)
	_panel.add_child(_name_label)

	_text_label = RichTextLabel.new()
	_text_label.bbcode_enabled = true
	_text_label.fit_content = true
	_text_label.scroll_active = false
	_text_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_text_label.add_theme_font_size_override(\"normal_font_size\", font_size)
	_text_label.add_theme_color_override(\"default_color\", text_color)
	_panel.add_child(_text_label)

	_continue_indicator = Label.new()
	_continue_indicator.text = \"▼\"
	_continue_indicator.visible = false
	_panel.add_child(_continue_indicator)


func _setup_prompt() -> void:
	if not show_prompt:
		return

	_prompt_label = Label.new()
	_prompt_label.text = prompt_text
	_prompt_label.visible = false
	_prompt_label.z_index = 99

	if _parent:
		_parent.add_child.call_deferred(_prompt_label)
	else:
		add_child(_prompt_label)

	_prompt_label.position = box_offset + Vector2(-50, -20)


# -------------------------------------------------------------------
# Input
# -------------------------------------------------------------------
func _unhandled_input(event: InputEvent) -> void:
	if not _dialogue_active and event.is_action_pressed(interaction_action):
		if can_repeat or not _has_shown_dialogue:
			_start_dialogue()
		return

	if _dialogue_active and event.is_action_pressed(advance_action):
		if not _text_complete:
			_complete_current_line()
		elif _waiting_for_input:
			_advance_dialogue()


# -------------------------------------------------------------------
# Dialogue flow
# -------------------------------------------------------------------
func _start_dialogue() -> void:
	if dialogue_lines.is_empty():
		return

	_dialogue_active = true
	_has_shown_dialogue = true
	_current_line = 0

	if _prompt_label:
		_prompt_label.visible = false

	_dialogue_box.visible = true
	_dialogue_box.scale = Vector2.ZERO

	var tween := create_tween()
	tween.tween_property(_dialogue_box, \"scale\", Vector2.ONE, popup_duration)

	await tween.finished
	_show_current_line()
	dialogue_started.emit()


func _show_current_line() -> void:
	if _current_line >= dialogue_lines.size():
		_end_dialogue()
		return

	_current_text = dialogue_lines[_current_line]
	await _resize_dialogue_box_for_text(_current_text)

	_displayed_characters = 0
	_text_timer = 0.0
	_text_complete = false
	_waiting_for_input = false
	_continue_indicator.visible = false
	_text_label.text = \"\"

	dialogue_line_shown.emit(_current_line)


func _advance_dialogue() -> void:
	_current_line += 1
	if _current_line >= dialogue_lines.size():
		_end_dialogue()
	else:
		_show_current_line()


func _end_dialogue() -> void:
	_dialogue_active = false
	_waiting_for_input = false

	var tween := create_tween()
	tween.tween_property(_dialogue_box, \"scale\", Vector2.ZERO, popup_duration * 0.7)
	await tween.finished

	_dialogue_box.visible = false

	if _prompt_label and can_repeat:
		_prompt_label.visible = true


# -------------------------------------------------------------------
# Rolling text
# -------------------------------------------------------------------
func _process(delta: float) -> void:
	if _dialogue_active and not _text_complete:
		_text_timer += delta
		var chars: int = int(_text_timer * characters_per_second)
		if chars > _displayed_characters:
			_displayed_characters = min(chars, _current_text.length())
			_text_label.text = _current_text.substr(0, _displayed_characters)

			if _displayed_characters >= _current_text.length():
				_text_complete = true
				_waiting_for_input = true
				_continue_indicator.visible = true


func _complete_current_line() -> void:
	_text_label.text = _current_text
	_text_complete = true
	_waiting_for_input = true
	_continue_indicator.visible = true


# -------------------------------------------------------------------
# Auto resize (strict typed)
# -------------------------------------------------------------------
func _resize_dialogue_box_for_text(text: String) -> void:
	_text_label.text = text
	await get_tree().process_frame

	var text_size: Vector2 = _text_label.get_content_size()

	var name_height: float
	if _name_label.visible:
		name_height = float(name_font_size + 4)
	else:
		name_height = 0.0

	var width: float = clamp(
		text_size.x + padding.x * 2.0,
		min_box_width,
		max_box_width
	)

	var height: float = clamp(
		text_size.y + padding.y * 2.0 + name_height + 16.0,
		min_box_height,
		max_box_height
	)

	var new_size := Vector2(width, height)

	_panel.size = new_size
	_dialogue_box.size = new_size
	_dialogue_box.position = box_offset - new_size / 2.0

	_name_label.position = Vector2(padding.x, padding.y)
	_text_label.position = Vector2(padding.x, padding.y + name_height)
	_text_label.size = Vector2(
		width - padding.x * 2.0,
		height - padding.y * 2.0 - name_height - 16.0
	)

	_continue_indicator.position = Vector2(
		width - padding.x - 16.0,
		height - padding.y - 16.0
	)


# -------------------------------------------------------------------
# Detection callback
# -------------------------------------------------------------------
func _on_body_entered(_body: Node2D) -> void:
	if _prompt_label and not _dialogue_active:
		_prompt_label.visible = true
"

