[sub_resource type="GDScript" id="GDScript_i1qk0"]
resource_name = "Librarian "
script/source = "class_name DialogueComponent
extends Node

## Simple dialogue system with rolling text.
## Attach as child of any Node2D. Press jump near character to talk.

signal dialogue_started
signal dialogue_finished

@export_group(\"Content\")
@export_multiline var dialogue_lines: Array[String] = [ \"Oh, hello Mari! This is the Wizard Tower, our officially sanctioned magical portion of the ship!\", \"It's alittle smaller than we'd like, but we're making it work.\" , \"This room houses books containing all of the magical history and knowledge you might need, but today, you're gonna test out a new simulation spell on the crystal ball\",]
@export var speaker_name: String = \"Mai, Librarian\"
@export var can_repeat: bool = true

@export_group(\"Interaction\")
@export var interaction_range: float = 80.0
@export var interaction_action: String = \"movement_jump\"

@export_group(\"Text\")
@export var chars_per_second: float = 25.0
@export var font_size: int = 14

@export_group(\"Box\")
@export var box_width: float = 220.0
@export var box_offset: Vector2 = Vector2(0, -50)
@export var padding: float = 10.0
@export var bg_color: Color = Color(0.05, 0.05, 0.1, 0.95)
@export var border_color: Color = Color(0.3, 0.3, 0.4, 1.0)

@export_group(\"Prompt\")
@export var show_prompt: bool = true
@export var prompt_text: String = \"Press [Jump]\"
@export var prompt_offset: Vector2 = Vector2(0, -30)

var _parent: Node2D
var _in_range: bool = false
var _active: bool = false
var _has_talked: bool = false
var _line_idx: int = 0
var _char_idx: int = 0
var _timer: float = 0.0
var _done: bool = false
var _waiting: bool = false

var _canvas: CanvasLayer
var _box: PanelContainer
var _vbox: VBoxContainer
var _name_label: Label
var _text_label: Label
var _arrow: Label
var _area: Area2D
var _prompt: Label


func _ready() -> void:
	_parent = get_parent() as Node2D
	_build_area()
	_build_ui()


func _build_area() -> void:
	_area = Area2D.new()
	_area.collision_layer = 0
	_area.collision_mask = 1
	
	var shape := CollisionShape2D.new()
	var circle := CircleShape2D.new()
	circle.radius = interaction_range
	shape.shape = circle
	_area.add_child(shape)
	
	_area.body_entered.connect(_on_player_enter)
	_area.body_exited.connect(_on_player_exit)
	
	if _parent:
		_parent.add_child.call_deferred(_area)
	else:
		add_child(_area)


func _build_ui() -> void:
	# Use CanvasLayer so UI is always on top and in screen space
	_canvas = CanvasLayer.new()
	_canvas.layer = 100
	add_child(_canvas)
	
	# Main container
	_box = PanelContainer.new()
	_box.visible = false
	_canvas.add_child(_box)
	
	# Style
	var style := StyleBoxFlat.new()
	style.bg_color = bg_color
	style.border_color = border_color
	style.set_border_width_all(2)
	style.set_corner_radius_all(4)
	style.set_content_margin_all(padding)
	_box.add_theme_stylebox_override(\"panel\", style)
	
	# VBox for content
	_vbox = VBoxContainer.new()
	_vbox.add_theme_constant_override(\"separation\", 4)
	_box.add_child(_vbox)
	
	# Name label
	_name_label = Label.new()
	_name_label.add_theme_font_size_override(\"font_size\", font_size - 2)
	_name_label.add_theme_color_override(\"font_color\", Color(0.6, 0.8, 1.0))
	_name_label.text = speaker_name
	_name_label.visible = speaker_name != \"\"
	_vbox.add_child(_name_label)
	
	# Text label
	_text_label = Label.new()
	_text_label.add_theme_font_size_override(\"font_size\", font_size)
	_text_label.add_theme_color_override(\"font_color\", Color.WHITE)
	_text_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_text_label.custom_minimum_size.x = box_width - padding * 2
	_vbox.add_child(_text_label)
	
	# Continue arrow
	_arrow = Label.new()
	_arrow.text = \"▼\"
	_arrow.add_theme_font_size_override(\"font_size\", 10)
	_arrow.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	_arrow.visible = false
	_vbox.add_child(_arrow)
	
	# Prompt label with background
	if show_prompt:
		_prompt = Label.new()
		_prompt.text = prompt_text
		_prompt.add_theme_font_size_override(\"font_size\", 10)
		_prompt.add_theme_color_override(\"font_color\", Color.WHITE)
		_prompt.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		_prompt.visible = false
		
		# Add background style to prompt
		var prompt_style := StyleBoxFlat.new()
		prompt_style.bg_color = Color(0, 0, 0, 0.6)
		prompt_style.set_corner_radius_all(3)
		prompt_style.set_content_margin_all(4)
		_prompt.add_theme_stylebox_override(\"normal\", prompt_style)
		
		_canvas.add_child(_prompt)


func _process(delta: float) -> void:
	# Update box position to follow parent
	if _parent:
		var screen_pos := _get_screen_pos()
		
		if _active and _box:
			var box_pos := screen_pos + box_offset
			_box.position = box_pos - Vector2(_box.size.x / 2, _box.size.y)
		
		# Always update prompt position so it's ready when shown
		if _prompt:
			var prompt_pos := screen_pos + prompt_offset
			_prompt.position = prompt_pos - Vector2(_prompt.size.x / 2, _prompt.size.y / 2)
	
	# Rolling text
	if _active and not _done:
		_timer += delta
		var target := int(_timer * chars_per_second)
		var full_text: String = dialogue_lines[_line_idx]
		
		if target > _char_idx:
			_char_idx = mini(target, full_text.length())
			_text_label.text = full_text.substr(0, _char_idx)
			
			if _char_idx >= full_text.length():
				_done = true
				_waiting = true
				_arrow.visible = true
	
	# Pulse arrow
	if _arrow.visible:
		_arrow.modulate.a = 0.5 + 0.5 * sin(Time.get_ticks_msec() * 0.006)
	
	# Pulse prompt
	if _prompt and _prompt.visible:
		_prompt.modulate.a = 0.6 + 0.4 * sin(Time.get_ticks_msec() * 0.004)


func _get_screen_pos() -> Vector2:
	var cam := get_viewport().get_camera_2d()
	if cam:
		return _parent.global_position - cam.global_position + get_viewport().get_visible_rect().size / 2
	else:
		return _parent.get_global_transform_with_canvas().origin


func _on_player_enter(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		_in_range = true
		if _prompt and not _active and (can_repeat or not _has_talked):
			_prompt.visible = true


func _on_player_exit(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		_in_range = false
		if _prompt:
			_prompt.visible = false


func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed(interaction_action):
		if not _active and _in_range and (can_repeat or not _has_talked):
			_open()
			get_viewport().set_input_as_handled()
		elif _active:
			if not _done:
				_skip_to_end()
			elif _waiting:
				_next()
			get_viewport().set_input_as_handled()


func _open() -> void:
	_active = true
	_line_idx = 0
	_start_line()
	
	if _prompt:
		_prompt.visible = false
	
	_box.visible = true
	_box.modulate.a = 0
	_box.scale = Vector2(0.8, 0.8)
	
	var tw := create_tween().set_parallel(true)
	tw.tween_property(_box, \"modulate:a\", 1.0, 0.15)
	tw.tween_property(_box, \"scale\", Vector2.ONE, 0.15).set_ease(Tween.EASE_OUT)
	
	dialogue_started.emit()


func _start_line() -> void:
	_char_idx = 0
	_timer = 0.0
	_done = false
	_waiting = false
	_arrow.visible = false
	_text_label.text = \"\"


func _skip_to_end() -> void:
	var full_text: String = dialogue_lines[_line_idx]
	_char_idx = full_text.length()
	_text_label.text = full_text
	_done = true
	_waiting = true
	_arrow.visible = true


func _next() -> void:
	_line_idx += 1
	_waiting = false
	_arrow.visible = false
	
	if _line_idx >= dialogue_lines.size():
		_close()
	else:
		_start_line()


func _close() -> void:
	_active = false
	_waiting = false
	_has_talked = true
	
	var tw := create_tween().set_parallel(true)
	tw.tween_property(_box, \"modulate:a\", 0.0, 0.1)
	tw.tween_property(_box, \"scale\", Vector2(0.8, 0.8), 0.1).set_ease(Tween.EASE_IN)
	tw.finished.connect(func(): _box.visible = false)
	
	if _prompt and _in_range and can_repeat:
		_prompt.visible = true
	
	dialogue_finished.emit()


# Public API

func start_dialogue() -> void:
	if not _active:
		_open()

func end_dialogue() -> void:
	if _active:
		_close()

func is_active() -> bool:
	return _active

func set_lines(lines: Array[String]) -> void:
	dialogue_lines = lines
	_line_idx = 0
	_has_talked = false
"

